{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://withdyad.com/protocol/harp/v0.1/schema/section.schema.json",
  "title": "HARP v0.1 section",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "section_id",
    "pair_principal_ids",
    "author_principal_id",
    "section_type",
    "content",
    "tags",
    "evidence_refs",
    "supersedes_section_id",
    "origin_kind",
    "origin_workspace_id",
    "origin_chat_id",
    "audience_scope",
    "lifecycle",
    "acceptance",
    "content_hash_algorithm",
    "content_hash",
    "created_at"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1"
    },
    "section_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "pair_principal_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    },
    "author_principal_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "section_type": {
      "enum": [
        "interaction",
        "capability",
        "context",
        "tension",
        "decision",
        "note"
      ]
    },
    "content": {
      "type": "string",
      "maxLength": 65536
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "supersedes_section_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin_kind": {
      "enum": [
        "chat",
        "workspace",
        "direct",
        "external",
        "system"
      ]
    },
    "origin_workspace_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin_chat_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "audience_scope": {
      "enum": [
        "pair",
        "origin_workspace",
        "public"
      ]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "version",
        "retracted_at",
        "retracted_by_principal_id"
      ],
      "properties": {
        "state": {
          "enum": [
            "active",
            "retracted"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "retracted_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
            },
            {
              "type": "null"
            }
          ]
        },
        "retracted_by_principal_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "active"
              }
            }
          },
          "then": {
            "properties": {
              "retracted_at": {
                "type": "null"
              },
              "retracted_by_principal_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "retracted"
              }
            }
          },
          "then": {
            "properties": {
              "retracted_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
              },
              "retracted_by_principal_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          }
        }
      ]
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "rows",
        "events"
      ],
      "properties": {
        "as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
        },
        "rows": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "principal_id",
              "state",
              "version",
              "updated_at"
            ],
            "properties": {
              "principal_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "state": {
                "enum": [
                  "pending",
                  "accepted",
                  "rejected",
                  "retracted"
                ]
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "updated_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
              }
            }
          }
        },
        "events": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "event_type",
              "actor_principal_id",
              "prior_state",
              "next_state",
              "state_version",
              "reason",
              "created_at"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "event_type": {
                "enum": [
                  "proposed",
                  "accepted",
                  "rejected",
                  "acceptance_retracted",
                  "section_retracted"
                ]
              },
              "actor_principal_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "prior_state": {
                "anyOf": [
                  {
                    "enum": [
                      "pending",
                      "accepted",
                      "rejected",
                      "retracted",
                      "active"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "next_state": {
                "anyOf": [
                  {
                    "enum": [
                      "pending",
                      "accepted",
                      "rejected",
                      "retracted"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 2048
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "created_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
              },
              "state_version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "event_type": {
                      "const": "proposed"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "prior_state": {
                      "type": "null"
                    },
                    "next_state": {
                      "type": "null"
                    },
                    "state_version": {
                      "const": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "event_type": {
                      "const": "accepted"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "prior_state": {
                      "const": "pending"
                    },
                    "next_state": {
                      "const": "accepted"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "event_type": {
                      "const": "rejected"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "prior_state": {
                      "const": "pending"
                    },
                    "next_state": {
                      "const": "rejected"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "event_type": {
                      "const": "acceptance_retracted"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "prior_state": {
                      "const": "accepted"
                    },
                    "next_state": {
                      "const": "retracted"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "event_type": {
                      "const": "section_retracted"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "prior_state": {
                      "const": "active"
                    },
                    "next_state": {
                      "const": "retracted"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "content_hash_algorithm": {
      "const": "sha256-jcs-nfc-v1"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256-jcs-nfc-v1:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "extensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string",
            "maxLength": 2048
          },
          {
            "type": "array",
            "maxItems": 32,
            "items": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "maxLength": 512
                }
              ]
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "origin_kind": {
            "const": "chat"
          }
        }
      },
      "then": {
        "properties": {
          "origin_workspace_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "origin_chat_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "origin_kind": {
            "const": "workspace"
          }
        }
      },
      "then": {
        "properties": {
          "origin_workspace_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "origin_chat_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "origin_kind": {
            "enum": [
              "direct",
              "external",
              "system"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "origin_workspace_id": {
            "type": "null"
          },
          "origin_chat_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "audience_scope": {
            "const": "origin_workspace"
          }
        }
      },
      "then": {
        "properties": {
          "origin_workspace_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://withdyad.com/protocol/harp/v0.1/schema/receipt.schema.json",
  "title": "HARP v0.1 governed work receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "kind",
    "dispatch_id",
    "generated_at",
    "acceptance_as_of",
    "disclosure",
    "participants",
    "obligation_transitions",
    "contributions",
    "final",
    "evidence_refs",
    "harp_updates",
    "identity_citations",
    "redactions"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1"
    },
    "kind": {
      "const": "harp_work_record"
    },
    "dispatch_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "acceptance_as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view",
        "workspace_id",
        "generated_for_principal_id"
      ],
      "properties": {
        "view": {
          "enum": [
            "pair_private",
            "origin_workspace",
            "public"
          ]
        },
        "workspace_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "generated_for_principal_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "participants": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    },
    "obligation_transitions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "maxProperties": 16,
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            },
            {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            }
          ]
        },
        "propertyNames": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        }
      }
    },
    "contributions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "maxProperties": 16,
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            },
            {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            }
          ]
        },
        "propertyNames": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        }
      }
    },
    "final": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "content_hash"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "harp_updates": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "classification",
          "audience_scope",
          "content_hash"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "classification": {
            "enum": [
              "bilateral_canon",
              "proposal",
              "attributed_observation",
              "retracted"
            ]
          },
          "audience_scope": {
            "enum": [
              "pair",
              "origin_workspace",
              "public"
            ]
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256-jcs-nfc-v1:[0-9a-f]{64}$"
          }
        }
      }
    },
    "identity_citations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_registry",
          "agent_id"
        ],
        "properties": {
          "agent_registry": {
            "type": "string",
            "maxLength": 256
          },
          "agent_id": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,77})$"
          }
        }
      }
    },
    "redactions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "count",
          "reason"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "maxLength": 128
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "maxLength": 2048
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string",
            "maxLength": 2048
          },
          {
            "type": "array",
            "maxItems": 32,
            "items": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "maxLength": 512
                }
              ]
            }
          }
        ]
      }
    }
  }
}

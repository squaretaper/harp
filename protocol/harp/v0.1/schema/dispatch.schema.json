{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://withdyad.com/protocol/harp/v0.1/schema/dispatch.schema.json",
  "title": "HARP v0.1 dispatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "dispatch_id",
    "workspace_id",
    "chat_id",
    "trigger_message_ref",
    "response_mode_requested",
    "response_mode_effective",
    "lead_principal_id",
    "dispatch_status",
    "barrier_status",
    "deadline_at",
    "final_message_id",
    "version",
    "participants",
    "obligations",
    "context_snapshot",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1"
    },
    "dispatch_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "chat_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "trigger_message_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "response_mode_requested": {
      "enum": [
        "adaptive",
        "solo",
        "parallel",
        "synthesis"
      ]
    },
    "response_mode_effective": {
      "enum": [
        "solo",
        "lead_riff",
        "parallel",
        "synthesis"
      ]
    },
    "lead_principal_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "dispatch_status": {
      "enum": [
        "open",
        "collecting",
        "synthesizing",
        "finalizing",
        "finalized",
        "cancelled"
      ]
    },
    "barrier_status": {
      "enum": [
        "open",
        "ready",
        "timed_out",
        "cancelled"
      ]
    },
    "deadline_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
        },
        {
          "type": "null"
        }
      ]
    },
    "final_message_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "principal_id",
          "role",
          "state",
          "version"
        ],
        "properties": {
          "principal_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "role": {
            "enum": [
              "lead",
              "contributor",
              "independent"
            ]
          },
          "state": {
            "enum": [
              "selected",
              "contributed",
              "declined",
              "timed_out",
              "cancelled"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "obligations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligation_id",
          "assignee_principal_id",
          "kind",
          "state",
          "deadline_at",
          "version"
        ],
        "properties": {
          "obligation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "assignee_principal_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "kind": {
            "const": "contribution"
          },
          "state": {
            "enum": [
              "pending",
              "acknowledged",
              "contributed",
              "declined",
              "timed_out",
              "cancelled"
            ]
          },
          "deadline_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "context_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "hash_algorithm",
        "hash",
        "byte_size"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "maxLength": 512
        },
        "hash_algorithm": {
          "const": "sha256"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "extensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string",
            "maxLength": 2048
          },
          {
            "type": "array",
            "maxItems": 32,
            "items": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "maxLength": 512
                }
              ]
            }
          }
        ]
      }
    }
  }
}
